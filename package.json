{
  "name": "qims",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test": "npm --workspace apps/web run test",
    "db:generate": "npm --workspace apps/web run db:generate",
    "db:migrate": "npm --workspace apps/web run db:migrate",
    "db:seed": "npm --workspace apps/web run db:seed",
    "db:seed:demo": "npm --workspace apps/web run db:seed:demo",
    "qa:mvp-smoke": "npm --workspace apps/web run qa:mvp-smoke",
    "mobile:start": "npm --workspace apps/mobile run start",
    "mobile:typecheck": "npm --workspace apps/mobile run typecheck",
    "mobile:build": "npm --workspace apps/mobile run build"
  },
  "devDependencies": {
    "eslint": "^9.39.1"
  },
  "overrides": {
    "kysely": "0.28.17"
  }
}
